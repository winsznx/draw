-- | Capital-call lifecycle for one fund.
--
-- Privacy shape: every per-LP contract has exactly two stakeholders, the fund
-- admin and that LP. Fund and CapitalCall have the admin as sole stakeholder,
-- so no LP-visible contract carries the LP roster or another LP's amount.
--
-- Settlement shape: an obligation moves to Funded only inside
-- 'Obligation_Settle', which checks a CIP-0056 Allocation against the
-- obligation and executes it in the same transaction. The LP's signature on
-- the obligation, given when it accepted its commitment, is the authority that
-- lets the admin execute that LP's matching allocation and nothing else.
--
-- Wallet shape (0.3.0): each obligation comes with a 'PaymentRequest' that
-- implements the CIP-0056 AllocationRequest interface, so the LP's standard
-- Canton wallet can show the call and create exactly the allocation that
-- 'Obligation_Settle' accepts. The request is archived when the obligation is
-- settled or waived.
--
-- Verifier shape (0.3.0): a fund can name an independent verifier party. It
-- observes the fund, each call header and each obligation, so it witnesses
-- every settlement through its own party, never the admin's.
module Draw.CapitalCall where

import DA.Foldable (forA_)
import DA.List (unique)
import DA.Optional (isNone, optionalToList)
import DA.Time (addRelTime, days, isLedgerTimeGE)
import qualified DA.TextMap as TextMap

import Splice.Api.Token.MetadataV1 (ChoiceExecutionMetadata(..), ExtraArgs, Metadata(..), emptyMetadata)
import Splice.Api.Token.HoldingV1 (Holding, HoldingView(..), InstrumentId)
import Splice.Api.Token.AllocationV1
import Splice.Api.Token.AllocationRequestV1

data ObligationState
  = Issued
  | PaymentPending
  | Funded
  | Overdue
  | Waived
  | ManualReview
  deriving (Eq, Show)

data SettlementRecord = SettlementRecord
  with
    allocationCid : ContractId Allocation
    transferLegId : Text
    receiverHoldingCids : [ContractId Holding]
    settledAmount : Decimal
    settledAfterDue : Bool
  deriving (Eq, Show)

data ObligationRequest = ObligationRequest
  with
    commitmentCid : ContractId InvestorCommitment
    obligationRef : Text
    amountDue : Decimal
    scenarioAmount : Decimal
  deriving (Eq, Show)

template Fund
  with
    admin : Party
    fundId : Text
    fundName : Text
    verifier : Optional Party
  where
    signatory admin
    observer optionalToList verifier

    nonconsuming choice Fund_InviteInvestor : ContractId CommitmentInvitation
      with
        lp : Party
        committedScenarioAmount : Decimal
        instrumentId : InstrumentId
      controller admin
      do
        assertMsg "lp must differ from admin" (lp /= admin)
        create CommitmentInvitation with
          admin; lp; fundId; fundName; committedScenarioAmount; instrumentId

    nonconsuming choice Fund_IssueCall : (ContractId CapitalCall, [ContractId CapitalCallObligation])
      with
        callId : Text
        description : Text
        dueAt : Time
        requests : [ObligationRequest]
      controller admin
      do
        assertMsg "call must request at least one obligation" (not (null requests))
        let refs = map (.obligationRef) requests
        assertMsg "obligation references must be unique within the call" (unique refs)
        issued <- forA requests \req ->
          exercise req.commitmentCid Commitment_IssueObligation with
            expectedFundId = fundId
            callId
            obligationRef = req.obligationRef
            amountDue = req.amountDue
            scenarioAmount = req.scenarioAmount
            dueAt
            verifier
        callCid <- create CapitalCall with
          admin; fundId; callId; description; dueAt
          obligationRefs = refs
          totalScenarioAmount = sum (map (.scenarioAmount) requests)
          totalAmountDue = sum (map (.amountDue) requests)
          verifier
        pure (callCid, map snd issued)

template CommitmentInvitation
  with
    admin : Party
    lp : Party
    fundId : Text
    fundName : Text
    committedScenarioAmount : Decimal
    instrumentId : InstrumentId
  where
    signatory admin
    observer lp
    ensure committedScenarioAmount > 0.0

    choice Invitation_Accept : ContractId InvestorCommitment
      controller lp
      do
        create InvestorCommitment with
          admin; lp; fundId; fundName; committedScenarioAmount; instrumentId
          calledScenarioAmount = 0.0

    choice Invitation_Decline : ()
      controller lp
      do pure ()

    choice Invitation_Withdraw : ()
      controller admin
      do pure ()

-- | One LP's commitment to the fund. Co-signed, so the admin can issue calls
-- against it up to the committed amount without a fresh LP signature per call.
template InvestorCommitment
  with
    admin : Party
    lp : Party
    fundId : Text
    fundName : Text
    committedScenarioAmount : Decimal
    calledScenarioAmount : Decimal
    instrumentId : InstrumentId
  where
    signatory admin, lp
    ensure committedScenarioAmount > 0.0
      && calledScenarioAmount >= 0.0
      && calledScenarioAmount <= committedScenarioAmount

    choice Commitment_IssueObligation : (ContractId InvestorCommitment, ContractId CapitalCallObligation)
      with
        expectedFundId : Text
        callId : Text
        obligationRef : Text
        amountDue : Decimal
        scenarioAmount : Decimal
        dueAt : Time
        verifier : Optional Party
      controller admin
      do
        assertMsg "commitment belongs to a different fund" (expectedFundId == fundId)
        let newCalled = calledScenarioAmount + scenarioAmount
        assertMsg "call exceeds remaining commitment" (newCalled <= committedScenarioAmount)
        commitmentCid <- create this with calledScenarioAmount = newCalled
        issuedAt <- getTime
        obligationCid <- create CapitalCallObligation with
          admin; lp; fundId; fundName; callId; obligationRef
          amountDue; scenarioAmount; instrumentId; dueAt
          state = Issued
          pendingAllocationCid = None
          settlement = None
          reviewNote = None
          verifier
          issuedAt = Some issuedAt
        -- The LP's wallet is asked to allocate by the due date. The fund then
        -- has a week to settle; a late LP can still pay through DRAW itself.
        create PaymentRequest with
          admin; lp; fundName; callId; obligationRef; amountDue; instrumentId
          requestedAt = issuedAt
          allocateBefore = dueAt
          settleBefore = addRelTime dueAt (days 7)
        pure (commitmentCid, obligationCid)

-- | Fund-level call header. Admin-only: it lists obligation references but no
-- LP parties or per-LP amounts.
template CapitalCall
  with
    admin : Party
    fundId : Text
    callId : Text
    description : Text
    dueAt : Time
    obligationRefs : [Text]
    totalScenarioAmount : Decimal
    totalAmountDue : Decimal
    verifier : Optional Party
  where
    signatory admin
    observer optionalToList verifier

template CapitalCallObligation
  with
    admin : Party
    lp : Party
    fundId : Text
    fundName : Text
    callId : Text
    obligationRef : Text
    amountDue : Decimal
    scenarioAmount : Decimal
    instrumentId : InstrumentId
    dueAt : Time
    state : ObligationState
    pendingAllocationCid : Optional (ContractId Allocation)
    settlement : Optional SettlementRecord
    reviewNote : Optional Text
    verifier : Optional Party
    issuedAt : Optional Time
  where
    signatory admin, lp
    observer optionalToList verifier
    ensure amountDue > 0.0 && scenarioAmount > 0.0

    choice Obligation_MarkPaymentPending : ContractId CapitalCallObligation
      with
        allocationCid : ContractId Allocation
      controller admin
      do
        assertMsg "only an issued obligation can become payment-pending" (state == Issued)
        allocation <- fetch allocationCid
        assertAllocationMatches this (view allocation)
        create this with state = PaymentPending; pendingAllocationCid = Some allocationCid

    choice Obligation_Settle : ContractId CapitalCallObligation
      with
        allocationCid : ContractId Allocation
        extraArgs : ExtraArgs
        paymentRequestCid : Optional (ContractId PaymentRequest)
      controller admin
      do
        assertMsg "obligation is not open for settlement"
          (state `elem` [Issued, PaymentPending, Overdue, ManualReview])
        assertMsg "obligation already carries a settlement" (isNone settlement)
        closePaymentRequest this paymentRequestCid
        allocation <- fetch allocationCid
        let allocationView = view allocation
        assertAllocationMatches this allocationView
        result <- exercise allocationCid Allocation_ExecuteTransfer with extraArgs
        receivedAmounts <- forA result.receiverHoldingCids \holdingCid -> do
          holding <- fetch holdingCid
          let HoldingView{owner, instrumentId = heldInstrument, amount} = view holding
          assertMsg "settled holding is not owned by the fund admin" (owner == admin)
          assertMsg "settled holding has the wrong instrument" (heldInstrument == instrumentId)
          pure amount
        let settledAmount = sum receivedAmounts
        assertMsg "settled amount does not equal amount due" (settledAmount == amountDue)
        settledAfterDue <- isLedgerTimeGE dueAt
        create this with
          state = Funded
          pendingAllocationCid = None
          settlement = Some SettlementRecord with
            allocationCid
            transferLegId = allocationView.allocation.transferLegId
            receiverHoldingCids = result.receiverHoldingCids
            settledAmount
            settledAfterDue

    choice Obligation_MarkOverdue : ContractId CapitalCallObligation
      controller admin
      do
        assertMsg "only an unpaid obligation can become overdue" (state `elem` [Issued, PaymentPending])
        pastDue <- isLedgerTimeGE dueAt
        assertMsg "obligation is not yet due" pastDue
        create this with state = Overdue

    choice Obligation_FlagManualReview : ContractId CapitalCallObligation
      with
        note : Text
      controller admin
      do
        assertMsg "only an open obligation can be flagged" (state `elem` [Issued, PaymentPending, Overdue])
        create this with state = ManualReview; reviewNote = Some note

    -- The payment this obligation was waiting on was withdrawn, expired, or
    -- refused. Back to Issued so a fresh payment can be matched. Never funds.
    choice Obligation_ReleasePending : ContractId CapitalCallObligation
      with
        note : Text
      controller admin
      do
        assertMsg "only a payment-pending obligation can be released" (state == PaymentPending)
        create this with state = Issued; pendingAllocationCid = None; reviewNote = Some note

    -- Review found nothing to settle or waive. Back to Issued. If the due time
    -- has passed, the admin can mark it overdue again.
    choice Obligation_Reopen : ContractId CapitalCallObligation
      with
        note : Text
      controller admin
      do
        assertMsg "only an obligation in manual review can be reopened" (state == ManualReview)
        create this with state = Issued; pendingAllocationCid = None; reviewNote = Some note

    choice Obligation_Waive : ContractId CapitalCallObligation
      with
        note : Text
        paymentRequestCid : Optional (ContractId PaymentRequest)
      controller admin
      do
        assertMsg "only an overdue or reviewed obligation can be waived" (state `elem` [Overdue, ManualReview])
        closePaymentRequest this paymentRequestCid
        create this with state = Waived; reviewNote = Some note

-- | What the LP's wallet sees: one CIP-0056 allocation request per
-- obligation, with the obligation reference as settlement reference and as
-- the transfer leg id, the fund admin as executor and receiver, and exactly
-- the amount and instrument due. An allocation created from it passes
-- 'assertAllocationMatches' unchanged.
template PaymentRequest
  with
    admin : Party
    lp : Party
    fundName : Text
    callId : Text
    obligationRef : Text
    amountDue : Decimal
    instrumentId : InstrumentId
    requestedAt : Time
    allocateBefore : Time
    settleBefore : Time
  where
    signatory admin
    observer lp
    ensure amountDue > 0.0 && allocateBefore < settleBefore

    interface instance AllocationRequest for PaymentRequest where
      view = AllocationRequestView with
        settlement = SettlementInfo with
          executor = admin
          settlementRef = Reference with id = obligationRef; cid = None
          requestedAt
          allocateBefore
          settleBefore
          meta = emptyMetadata
        transferLegs = TextMap.fromList
          [ (obligationRef, TransferLeg with
              sender = lp
              receiver = admin
              amount = amountDue
              instrumentId
              meta = emptyMetadata) ]
        meta = Metadata with
          values = TextMap.fromList
            [("splice.lfdecentralizedtrust.org/reason", "Capital call " <> callId <> ", " <> fundName)]

      -- The LP declines to pay through its wallet. The obligation stays open
      -- and the fund decides what happens next.
      allocationRequest_RejectImpl _self AllocationRequest_Reject{actor} = do
        assertMsg "only the LP who owes this payment can reject it" (actor == lp)
        pure ChoiceExecutionMetadata with meta = emptyMetadata

      allocationRequest_WithdrawImpl _self _arg =
        pure ChoiceExecutionMetadata with meta = emptyMetadata

-- | Archives the obligation's payment request when one is given. It must be
-- the request for this obligation, from this admin to this LP.
closePaymentRequest : CapitalCallObligation -> Optional (ContractId PaymentRequest) -> Update ()
closePaymentRequest _ None = pure ()
closePaymentRequest obligation (Some requestCid) = do
  request <- fetch requestCid
  assertMsg "payment request belongs to a different obligation"
    (request.obligationRef == obligation.obligationRef && request.admin == obligation.admin && request.lp == obligation.lp)
  archive requestCid

-- | The allocation must name this obligation's reference as both settlement
-- reference and transfer leg id, come from this LP, pay this admin, be executed
-- by this admin, and carry exactly the amount and instrument due.
assertAllocationMatches : CapitalCallObligation -> AllocationView -> Update ()
assertAllocationMatches obligation allocationView = do
  let spec = allocationView.allocation
      leg = spec.transferLeg
      checks =
        [ ("allocation settlement reference does not match obligation", spec.settlement.settlementRef.id == obligation.obligationRef)
        , ("allocation transfer leg id does not match obligation", spec.transferLegId == obligation.obligationRef)
        , ("allocation executor is not the fund admin", spec.settlement.executor == obligation.admin)
        , ("allocation sender is not the obligated LP", leg.sender == obligation.lp)
        , ("allocation receiver is not the fund admin", leg.receiver == obligation.admin)
        , ("allocation instrument does not match obligation", leg.instrumentId == obligation.instrumentId)
        , ("allocation amount does not equal amount due", leg.amount == obligation.amountDue)
        ]
  forA_ checks \(message, ok) -> assertMsg message ok
